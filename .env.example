# ==============================================================================
# Finance AI Service — Variáveis de Ambiente (Render + Neon PostgreSQL)
# ==============================================================================
PORT=8080

# Banco de Dados (omitir para usar H2 em memória localmente; configurar para Neon em produção)
# Exemplo Neon: jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/smartbudgetdb?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DB_POOL_MAX_SIZE=5

# Provedores de IA (configure pelo menos uma chave real no Render)
AI_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=groq
AI_FALLBACK_ENABLED=true

# Segurança (MESMA chave configurada no BFF Next.js / Vercel)
INTERNAL_API_KEY=

# Mantenha false em produção para evitar RCE (H2 Console) e exposição de docs (Swagger)
H2_CONSOLE_ENABLED=false
SWAGGER_ENABLED=false

# Em arquitetura BFF server-to-server, deixe vazio.
CORS_ALLOWED_ORIGINS=

# No Render, defina true (o Render atua como reverse proxy confiável)
TRUST_PROXY_HEADERS=true

# Rate limiting e limites de retenção
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI_RPM=15
RATE_LIMIT_WRITE_RPM=40
RATE_LIMIT_READ_RPM=120
SESSION_RETENTION_HOURS=24
MAX_TRANSACTIONS_PER_SESSION=200
MAX_TOTAL_TRANSACTIONS=5000
